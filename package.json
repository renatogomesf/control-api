{
    "name": "teste-api",
    "version": "1.0.0",
    "main": "src/server.ts",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node build/src/server.js",
        "docker": "docker compose up -d",
        "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/data-source.ts src/db/migrations",
        "migration:run": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
        "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/data-source.ts",
        "createUser": "tsx src/utils/createUser.ts",
        "test:login": "vitest run test/login.test.ts",
        "test:register": "vitest run test/register.test.ts",
        "test:user": "vitest run test/user.test.ts",
        "test:goal": "vitest run test/goal.test.ts",
        "test:revenue": "vitest run test/revenue.test.ts",
        "test:expense": "vitest run test/expense.test.ts",
        "test:amountToReceive": "vitest run test/amountToReceive.test.ts",
        "test:amountToPay": "vitest run test/amountToPay.test.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "",
    "devDependencies": {
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.7.2",
        "@types/supertest": "^6.0.3",
        "@types/swagger-ui-express": "^4.1.8",
        "supertest": "^7.1.4",
        "swagger-autogen": "^2.23.7",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3",
        "vitest": "^4.0.5"
    },
    "dependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^5.1.0",
        "jsonwebtoken": "^9.0.2",
        "mysql2": "^3.16.0",
        "reflect-metadata": "^0.2.2",
        "swagger-ui-express": "^5.0.1",
        "typeorm": "^0.3.27"
    }
}
