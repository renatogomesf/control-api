MYSQL_PORT = 3306 # use este
MYSQL_PASSWORD = 
MYSQL_DATABASE = 

# (mesma senha do MYSQL_PASSWORD)
# (usado no container com o MySQL)
MYSQL_ROOT_PASSWORD = 

DB_USER = 

# ==========3° - Adicione os dados do servidor==========
SERVER_PORT = 
SERVER_HOST = 0.0.0.0 # use este

# ==========4° - Crie uma chave jwt==========
